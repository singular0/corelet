<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS will not hand Bluetooth to a process that has no usage description, and
  a plain executable has nowhere to put one, so the Mac build is a bundle. This
  only matters for development: the target is the uConsole.
-->
<plist version="1.0">
<dict>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>Corelet</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.singular0.corelet</string>
    <key>CFBundleName</key>
    <string>Corelet</string>
    <key>CFBundleIconFile</key>
    <string>corelet.icns</string>
    <key>CFBundleShortVersionString</key>
    <string>@CORELET_VERSION_CORE@</string>
    <key>CFBundleVersion</key>
    <string>@CORELET_VERSION_BUILD@</string>
    <key>CoreletVersion</key>
    <string>@CORELET_VERSION@</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Corelet talks to your MeshCore device over Bluetooth LE.</string>
</dict>
</plist>
