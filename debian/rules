#!/usr/bin/make -f

# The companion protocol is unauthenticated and this process parses frames off
# a socket, so take everything the toolchain offers rather than the defaults.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Nothing here is architecture-specific: the same rules build the uConsole's
# arm64 package and an amd64 one. dh's cmake buildsystem configures with
# CMAKE_BUILD_TYPE=None so the flags come from dpkg-buildflags, which is what
# the hardening options above feed.
%:
	dh $@ --buildsystem=cmake

# scripts/build-deb.sh creates this manifest before copying the source into its
# staging tree. Passing the snapshot through keeps the Git-less staged compile,
# package metadata and filename on precisely the same version.
override_dh_auto_configure:
	dh_auto_configure --buildsystem=cmake -- \
		-DCORELET_VERSION_MANIFEST=$(CURDIR)/.corelet-version.cmake
